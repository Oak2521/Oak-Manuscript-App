{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oakbylake.com/schemas/oak-manuscript-sync-http-audit-v1.schema.json",
  "title": "Oak Manuscript Sync HTTP Security Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_type", "request_id", "occurred_at", "method", "route",
    "http_status", "error_code"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_type": { "const": "sync_http_request_completed" },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "method": { "type": "string", "pattern": "^[A-Z]{1,16}$" },
    "route": {
      "enum": [
        "/manuscript/api/v1/sync-records",
        "/manuscript/api/v1/sync-records/:idempotency_id",
        "unmatched"
      ]
    },
    "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "error_code": {
      "type": ["string", "null"],
      "enum": [
        null, "ACCOUNT_RECORD_LIMIT", "AUTH_REQUIRED", "BODY_LENGTH_MISMATCH",
        "CROSS_SITE_REQUEST", "CSRF_REQUIRED", "IDEMPOTENCY_CONFLICT",
        "INSECURE_TRANSPORT", "INVALID_HEADERS", "INVALID_JSON", "INVALID_RECORD",
        "LENGTH_REQUIRED", "METHOD_NOT_ALLOWED", "NOT_FOUND", "RECORD_NOT_FOUND",
        "REQUEST_TOO_LARGE", "SERVICE_UNAVAILABLE", "TRANSFER_ENCODING_NOT_ALLOWED",
        "UNSUPPORTED_MEDIA_TYPE"
      ]
    }
  }
}
