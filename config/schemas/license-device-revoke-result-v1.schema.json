{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oakbylake.com/schemas/oak-manuscript/license-device-revoke-result-v1.schema.json",
  "title": "Oak Manuscript license device revoke result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outcome", "device"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "outcome": { "const": "revoked" },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["device_id", "device_state", "first_seen_at", "last_seen_at", "revoked_at"],
      "properties": {
        "device_id": { "type": "string", "pattern": "^device-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "device_state": { "const": "revoked" },
        "first_seen_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "last_seen_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "revoked_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
      }
    }
  }
}
