{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oakbylake.com/schemas/oak-manuscript/license-account-http-error-v1.schema.json",
  "title": "Oak Manuscript license account HTTP error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "error", "request_id"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "request_id": { "type": "string", "format": "uuid" }
  },
  "$defs": {
    "errorCode": {
      "enum": ["AUTH_REQUIRED", "BODY_LENGTH_MISMATCH", "CROSS_SITE_REQUEST", "DEVICE_NOT_FOUND", "INSECURE_TRANSPORT", "INVALID_HEADERS", "INVALID_JSON", "INVALID_REQUEST", "LENGTH_REQUIRED", "METHOD_NOT_ALLOWED", "NOT_FOUND", "REQUEST_TOO_LARGE", "SERVICE_UNAVAILABLE", "TRANSFER_ENCODING_NOT_ALLOWED", "UNSUPPORTED_MEDIA_TYPE"]
    }
  }
}
