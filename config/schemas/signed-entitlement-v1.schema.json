{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oakbylake.com/schemas/oak-manuscript/signed-entitlement-v1.schema.json",
  "title": "Oak Manuscript signed entitlement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "key_id", "algorithm", "claims", "signature"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "oak_manuscript_signed_entitlement" },
    "key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "algorithm": { "const": "Ed25519" },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audience", "entitlement_id", "account_id", "device_id", "tier", "device_state", "issued_at", "not_before", "valid_until", "grace_until"],
      "properties": {
        "issuer": { "type": "string", "format": "uri", "maxLength": 2048 },
        "audience": { "const": "oak-manuscript-desktop" },
        "entitlement_id": { "type": "string", "pattern": "^ent-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "account_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "device_id": { "type": "string", "pattern": "^device-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "tier": { "const": "pro" },
        "device_state": { "enum": ["active", "revoked"] },
        "issued_at": { "type": "string", "format": "date-time" },
        "not_before": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" },
        "grace_until": { "type": "string", "format": "date-time" }
      }
    },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}
