{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oakbylake.com/schemas/oak-manuscript/entitlement-request-v1.schema.json",
  "title": "Oak Manuscript entitlement request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_type", "device_id"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_type": { "const": "oak_manuscript_entitlement_request" },
    "device_id": { "type": "string", "pattern": "^device-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
  }
}
