{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oakbylake.com/schemas/oak-manuscript-web-job-deletion-v1.schema.json",
  "title": "Oak Manuscript Web Job Deletion Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_type", "job_id", "reason", "deleted_at",
    "input_deleted", "output_deleted"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "receipt_type": { "const": "oak_manuscript_web_job_deletion" },
    "job_id": {
      "type": "string",
      "pattern": "^webjob-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason": { "enum": ["canceled", "expired", "user_deleted", "processing_failed", "downloaded"] },
    "deleted_at": { "type": "string", "format": "date-time" },
    "input_deleted": { "const": true },
    "output_deleted": { "const": true }
  }
}
