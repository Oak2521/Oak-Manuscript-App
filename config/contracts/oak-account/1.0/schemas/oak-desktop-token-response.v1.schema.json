{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oakbylake.com/identity/oak-desktop-token-response-1.0.schema.json",
  "title": "Oak Desktop Application Token Response 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "token_type", "access_token", "expires_in", "refresh_token", "refresh_expires_at", "claims"],
  "properties": {
    "schema_version": {"const": "oak-desktop-token-response/1.0"},
    "token_type": {"const": "Bearer"},
    "access_token": {"type": "string", "minLength": 64, "maxLength": 8192, "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"},
    "expires_in": {"type": "integer", "minimum": 60, "maximum": 300},
    "refresh_token": {"type": "string", "minLength": 43, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$"},
    "refresh_expires_at": {"type": "string", "format": "date-time"},
    "claims": {"$ref": "oak-desktop-session-claims.v1.schema.json"}
  }
}
