{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oakbylake.com/identity/oak-desktop-login-exchange-1.0.schema.json",
  "title": "Oak Desktop One-Time Code Exchange 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "application_id", "code", "code_verifier", "redirect_uri"],
  "properties": {
    "schema_version": {"const": "oak-desktop-login-exchange/1.0"},
    "application_id": {"enum": ["oak-manuscript-desktop", "oak-research-desktop"]},
    "code": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$"},
    "code_verifier": {"type": "string", "pattern": "^[A-Za-z0-9._~-]{43,128}$"},
    "redirect_uri": {"type": "string", "maxLength": 512, "pattern": "^http://127\\.0\\.0\\.1:[0-9]{4,5}/application-login/callback/[A-Za-z0-9_-]{43,128}$"}
  }
}
