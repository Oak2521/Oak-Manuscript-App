{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oakbylake.com/identity/oak-desktop-login-authorization-1.0.schema.json",
  "title": "Oak Desktop Login Authorization Request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "application_id", "redirect_uri", "state", "code_challenge", "code_challenge_method", "request_expires_at"],
  "properties": {
    "schema_version": {"const": "oak-desktop-login-authorization/1.0"},
    "application_id": {"enum": ["oak-manuscript-desktop", "oak-research-desktop"]},
    "redirect_uri": {"type": "string", "maxLength": 512, "pattern": "^http://127\\.0\\.0\\.1:[0-9]{4,5}/application-login/callback/[A-Za-z0-9_-]{43,128}$"},
    "state": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$"},
    "code_challenge": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "code_challenge_method": {"const": "S256"},
    "request_expires_at": {"type": "string", "format": "date-time"}
  }
}
